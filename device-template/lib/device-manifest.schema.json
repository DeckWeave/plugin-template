{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeckWeave provisional device manifest protocol 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "protocol",
    "id",
    "name",
    "version",
    "runtime",
    "entry",
    "models",
    "platforms"
  ],
  "properties": {
    "kind": { "const": "device" },
    "protocol": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9_-]*){2,}$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][a-zA-Z0-9.-]+)?$"
    },
    "runtime": { "enum": ["node", "native"] },
    "entry": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))[^/:\\x00-\\x1f]+(?:/[^/:\\x00-\\x1f]+)*$"
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9_-]*){2,}$"
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["windows", "macos", "linux"] }
    }
  }
}
